<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:c="using:SourceGit.Converters"
             xmlns:v="using:SourceGit.Views"
             x:Class="SourceGit.Views.ReviewCommentEditor"
             x:DataType="vm:ReviewDiffContext"
             LostFocus="OnLostFocus">
  <Border Background="{DynamicResource Brush.Contents}" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}" CornerRadius="4">
    <Grid RowDefinitions="*,1,Auto">
      <v:CommitMessageTextEditor Grid.Row="0" x:Name="BodyEditor"
                                 CommitMessage="{Binding Body, Mode=TwoWay}"
                                 ShowSubjectGuide="False"
                                 Placeholder="{DynamicResource Text.Reviews.CommentPlaceholder}"
                                 Foreground="{DynamicResource Brush.FG1}"
                                 FontFamily="{DynamicResource Fonts.Default}"
                                 FontSize="{Binding Source={x:Static vm:Preferences.Instance}, Path=EditorFontSize}"/>
      <Rectangle Grid.Row="1" Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsHitTestVisible="False" Fill="{DynamicResource Brush.Border2}"/>
      <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Background="{DynamicResource Brush.Window}">
        <ComboBox Grid.Column="0" Width="128" Margin="4,2" ItemsSource="{Binding StateChoices}" SelectedItem="{Binding State, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="m:ReviewCommentState">
              <TextBlock Text="{Binding Converter={x:Static c:ReviewConverters.ToStateLabel}}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="4,0">
          <TextBlock Text="{Binding AnchorLabel}" IsVisible="{Binding ShowAnchorLabel}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding AttachmentLabel}" Foreground="{DynamicResource Brush.FG2}"
                     IsVisible="{Binding AttachmentLabel, Converter={x:Static c:StringConverters.IsNotNullOrWhitespace}}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0">
          <Button Classes="flat" Height="22" Padding="6,0" Margin="4,0,0,0"
                  Content="{DynamicResource Text.Reviews.Reattach}" Command="{Binding BeginReattach}" IsVisible="{Binding CanReattach}"/>
          <Button Classes="flat" Height="22" Padding="6,0" Margin="4,0,0,0"
                  Content="{DynamicResource Text.Reviews.OpenOriginal}" Command="{Binding OpenOriginal}" IsVisible="{Binding CanOpenOriginal}"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
