<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:c="using:SourceGit.Converters"
             xmlns:v="using:SourceGit.Views"
             x:Class="SourceGit.Views.ReviewCommentEditor"
             x:DataType="vm:ReviewDiffContext">
  <Border Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="1" CornerRadius="4" Padding="10">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding AnchorLabel}" FontWeight="Bold"/>
        <TextBlock Text="{Binding AttachmentLabel}" Foreground="{DynamicResource Brush.FG2}"/>
        <Border BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="1" Background="{DynamicResource Brush.Contents}">
          <v:CommitMessageTextEditor x:Name="BodyEditor" CommitMessage="{Binding Body, Mode=TwoWay}"
                                     ShowSubjectGuide="False" MinHeight="100" Height="160" MaxHeight="260"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                     Foreground="{DynamicResource Brush.FG1}" FontFamily="{DynamicResource Fonts.Default}"
                                     FontSize="{Binding Source={x:Static vm:Preferences.Instance}, Path=EditorFontSize}"
                                     Placeholder="{DynamicResource Text.Reviews.CommentPlaceholder}"/>
        </Border>
        <ComboBox ItemsSource="{Binding StateChoices}" SelectedItem="{Binding State, Mode=TwoWay}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="m:ReviewCommentState">
              <TextBlock Text="{Binding Converter={x:Static c:ReviewConverters.ToStateLabel}}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <WrapPanel Orientation="Horizontal">
          <Button Margin="0,0,6,6" Content="{DynamicResource Text.Reviews.Reattach}" Command="{Binding BeginReattach}" IsVisible="{Binding CanReattach}"/>
          <Button Margin="0,0,6,6" Content="{DynamicResource Text.Reviews.OpenOriginal}" Command="{Binding OpenOriginal}" IsVisible="{Binding CanOpenOriginal}"/>
          <Button Margin="0,0,0,6" Content="{DynamicResource Text.Reviews.CloseComment}" Command="{Binding CloseEditor}"/>
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
