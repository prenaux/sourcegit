<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             xmlns:c="using:SourceGit.Converters"
             x:Class="SourceGit.Views.Reviews"
             x:DataType="vm:Reviews">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="0,4,0,0">
    <WrapPanel Grid.Row="0" Orientation="Horizontal" IsEnabled="{Binding !IsBusy}">
      <Button Margin="0,0,6,6" Content="{DynamicResource Text.Reviews.UpdateSnapshot}" Command="{Binding UpdateSnapshot}" IsVisible="{Binding SourceChanged}"/>
      <TextBlock Margin="0,0,6,6" Text="{DynamicResource Text.Reviews.SourceChanged}" IsVisible="{Binding SourceChanged}" VerticalAlignment="Center"/>
    </WrapPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,6,*" Margin="0,0,0,6" IsEnabled="{Binding !IsBusy}">
      <ComboBox Grid.Column="0" ItemsSource="{Binding SavedReviews}" SelectedItem="{Binding SelectedReview, Mode=TwoWay}"
                PlaceholderText="{DynamicResource Text.Reviews.SavedReviews}" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="m:Review">
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ComboBox Grid.Column="2" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot, Mode=TwoWay}" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="m:ReviewSnapshot">
            <TextBlock Text="{Binding Converter={x:Static c:ReviewConverters.ToSnapshotLabel}}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="260,4,*" IsEnabled="{Binding !IsBusy}">
      <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto,Auto,*">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,4">
          <TextBox Text="{Binding FileFilter, Mode=TwoWay}" Watermark="{DynamicResource Text.Reviews.FilterFiles}"/>
          <ComboBox ItemsSource="{Binding ReviewFilterChoices}" SelectedItem="{Binding ReviewFilter, Mode=TwoWay}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ReviewFileFilter">
                <TextBlock Text="{Binding Converter={x:Static c:ReviewConverters.ToReviewFilterLabel}}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <ListBox x:Name="FileList" Grid.Row="1" ContextRequested="OnFileContextRequested" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}" Background="{DynamicResource Brush.Contents}">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="MinHeight" Value="46"/>
              <Setter Property="Padding" Value="4"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ReviewFileItem">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Path}" HorizontalAlignment="Stretch" TextAlignment="Right" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding Path}"/>
                <TextBlock FontSize="11" Foreground="{DynamicResource Brush.FG2}">
                  <Run Text="{Binding ReviewStatus}"/><Run Text="  "/><Run Text="{Binding CommentCount}"/>
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Spacing="4" Margin="0,6,0,6" IsEnabled="{Binding HasFile}">
          <Button Content="{DynamicResource Text.Reviews.AddFileComment}" Command="{Binding AddFileComment}"/>
          <Button Content="{DynamicResource Text.Reviews.ResolveRemaining}" Command="{Binding ResolveRemainingComments}"/>
          <Grid ColumnDefinitions="*,Auto">
            <ComboBox ItemsSource="{Binding StateChoices}" SelectedItem="{Binding BulkState, Mode=TwoWay}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="m:ReviewCommentState">
                  <TextBlock Text="{Binding Converter={x:Static c:ReviewConverters.ToStateLabel}}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Margin="4,0,0,0" Content="{DynamicResource Text.Reviews.SetAll}" Command="{Binding SetAllCommentStates}"/>
          </Grid>
          <Button Content="{DynamicResource Text.Reviews.Undo}" Command="{Binding UndoCommentStates}" IsEnabled="{Binding CanUndo}"/>
        </StackPanel>
        <TextBlock Grid.Row="3" Text="{DynamicResource Text.Reviews.Comments}" FontWeight="Bold" Margin="0,0,0,4"/>
        <ListBox x:Name="CommentList" Grid.Row="4" KeyDown="OnCommentsKeyDown" ItemsSource="{Binding Comments}" SelectedItem="{Binding SelectedComment, Mode=TwoWay}" Background="{DynamicResource Brush.Contents}">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="MinHeight" Value="72"/>
              <Setter Property="Padding" Value="4"/>
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ReviewCommentItem">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Body}" TextWrapping="Wrap" MaxHeight="38"/>
                <TextBlock Text="{Binding State}" FontSize="11"/>
                <TextBlock Text="{Binding Attachment}" FontSize="11" Foreground="{DynamicResource Brush.FG2}"/>
                <TextBlock Text="{Binding Location}" FontSize="11" Foreground="{DynamicResource Brush.FG2}"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>
      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="4,0,0,4">
          <SelectableTextBlock x:Name="ComparisonLabel" Text="{Binding ComparisonLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          <CheckBox Grid.Column="1" Content="{DynamicResource Text.Reviews.SideBySide}" IsChecked="{Binding UseSideBySide, Mode=TwoWay}" Margin="8,0"/>
          <Button Grid.Column="2" Classes="icon_button" Width="28" Click="OnGotoFirstChange" IsVisible="{Binding HasTextDiff}" ToolTip.Tip="{DynamicResource Text.Diff.First}">
            <Path Width="12" Height="12" Data="{StaticResource Icons.Top}"/>
          </Button>
          <Button Grid.Column="3" Classes="icon_button" Width="28" Click="OnGotoPrevChange" IsVisible="{Binding HasTextDiff}" ToolTip.Tip="{DynamicResource Text.Diff.Prev}">
            <Path Width="12" Height="12" Data="{StaticResource Icons.Up}"/>
          </Button>
          <TextBlock Grid.Column="4" Text="{Binding Diff.BlockNavigation.Indicator}" VerticalAlignment="Center" Margin="4,0"/>
          <Button Grid.Column="5" Classes="icon_button" Width="28" Click="OnGotoNextChange" IsVisible="{Binding HasTextDiff}" ToolTip.Tip="{DynamicResource Text.Diff.Next}">
            <Path Width="12" Height="12" Data="{StaticResource Icons.Down}"/>
          </Button>
          <Button Grid.Column="6" Classes="icon_button" Width="28" Click="OnGotoLastChange" IsVisible="{Binding HasTextDiff}" ToolTip.Tip="{DynamicResource Text.Diff.Last}">
            <Path Width="12" Height="12" Data="{StaticResource Icons.Bottom}"/>
          </Button>
          <Button Grid.Column="7" Content="{DynamicResource Text.Reviews.CopyReview}" Command="{Binding CopyReview}" IsEnabled="{Binding HasReview}"/>
        </Grid>
        <SelectableTextBlock Grid.Row="1" Margin="4,0,4,4" Text="{Binding SelectedFileFullPath}" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding SelectedFileFullPath}"/>
        <TextBlock Grid.Row="2" Margin="4,0,4,4" Text="{Binding FileViewNotice}" TextWrapping="Wrap" IsVisible="{Binding FileViewNotice, Converter={x:Static c:StringConverters.IsNotNullOrWhitespace}}"/>
        <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="1" Background="{DynamicResource Brush.Contents}">
          <Grid ClipToBounds="True">
            <ContentControl Content="{Binding Diff}" IsVisible="{Binding HasTextDiff}">
              <ContentControl.DataTemplates>
                <DataTemplate x:DataType="vm:TextDiffContext">
                  <v:TextDiffView SelectedChunk="{Binding SelectedChunk, Mode=OneWay}"/>
                </DataTemplate>
              </ContentControl.DataTemplates>
            </ContentControl>
            <ScrollViewer IsVisible="{Binding !HasTextDiff}" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="12" Spacing="12">
                <TextBlock Text="{DynamicResource Text.Reviews.NoInlineDiff}" TextWrapping="Wrap" IsVisible="{Binding HasReview}"/>
                <Border IsVisible="{Binding Context.IsEditing, FallbackValue=False, TargetNullValue=False}">
                  <v:ReviewCommentEditor DataContext="{Binding Context}"/>
                </Border>
              </StackPanel>
            </ScrollViewer>
            <v:LoadingIcon Width="32" Height="32" IsVisible="{Binding IsLoadingFile}" IsHitTestVisible="False"/>
          </Grid>
        </Border>
        <Grid x:Name="GeneralReviewSection" Grid.Row="4" RowDefinitions="24,Auto" HorizontalAlignment="Stretch" IsEnabled="{Binding HasReview}" Margin="0,6,0,0">
          <ToggleButton Classes="icon_button" Height="24" Padding="4,0" HorizontalAlignment="Left" IsChecked="{Binding IsGeneralExpanded, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Grid Width="10" Height="10">
                <Path Data="{StaticResource Icons.Up}" IsVisible="{Binding IsGeneralExpanded}"/>
                <Path Data="{StaticResource Icons.Down}" IsVisible="{Binding !IsGeneralExpanded}"/>
              </Grid>
              <TextBlock Text="{DynamicResource Text.Reviews.GeneralReview}"/>
            </StackPanel>
          </ToggleButton>
          <Border x:Name="GeneralReviewEditorFrame" Grid.Row="1" HorizontalAlignment="Stretch" IsVisible="{Binding IsGeneralExpanded}"
                  Background="{DynamicResource Brush.Contents}" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}" CornerRadius="4">
            <v:CommitMessageTextEditor x:Name="GeneralReviewEditor" CommitMessage="{Binding GeneralReviewMessage, Mode=TwoWay}"
                                       HorizontalAlignment="Stretch"
                                       Placeholder="{DynamicResource Text.Reviews.GeneralPlaceholder}"
                                       SubjectLineBrush="{DynamicResource Brush.Border2}"
                                       SubjectGuideLength="{Binding Source={x:Static vm:Preferences.Instance}, Path=SubjectGuideLength}"
                                       Foreground="{DynamicResource Brush.FG1}" FontFamily="{DynamicResource Fonts.Default}"
                                       FontSize="{Binding Source={x:Static vm:Preferences.Instance}, Path=EditorFontSize}"
                                       MinHeight="140" Height="180" MaxHeight="300"/>
          </Border>
        </Grid>
      </Grid>
    </Grid>
    <TextBlock Grid.Row="2" Text="{DynamicResource Text.Reviews.Empty}" IsVisible="{Binding !HasReview}"
               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" Margin="16"/>
    <v:LoadingIcon Grid.Row="2" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" IsHitTestVisible="False"/>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
      <TextBlock Grid.Column="1" Text="{Binding SaveStatus}" Foreground="{DynamicResource Brush.FG2}" Margin="8,0,0,0"/>
    </Grid>
  </Grid>
</UserControl>
