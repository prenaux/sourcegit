<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:c="using:SourceGit.Converters"
             x:Class="SourceGit.Views.Reviews"
             x:DataType="vm:Reviews">
  <Grid RowDefinitions="*,Auto" Margin="4">
    <Grid Grid.Row="0" ColumnDefinitions="320,4,*">
      <ListBox Grid.Column="0"
               x:Name="ReviewList"
               Background="{DynamicResource Brush.Contents}"
               BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}"
               ItemsSource="{Binding Items}"
               SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
               DoubleTapped="OnReviewListDoubleTapped">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="6,4"/>
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ReviewListItem">
            <StackPanel Spacing="1">
              <TextBlock Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource Brush.FG2}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Counts}" FontSize="11" Foreground="{DynamicResource Brush.FG2}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <GridSplitter Grid.Column="1"
                    MinWidth="1"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="Transparent"
                    Focusable="False"/>

      <Grid Grid.Column="2" RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,4" IsEnabled="{Binding HasSelection}">
          <Button x:Name="OpenReviewButton" Classes="flat" Height="24" Padding="8,0" Content="{DynamicResource Text.Reviews.Open}" Click="OnOpenReview"/>
          <Button x:Name="CopyReviewButton" Classes="flat" Height="24" Padding="8,0" Content="{DynamicResource Text.Reviews.CopyReview}" Click="OnCopyReview"/>
          <Button x:Name="DeleteReviewButton" Classes="flat" Height="24" Padding="8,0" Content="{DynamicResource Text.Reviews.Delete}" Click="OnDeleteReview"/>
        </StackPanel>

        <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}" Background="{DynamicResource Brush.Contents}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <SelectableTextBlock x:Name="ReviewText"
                                 Margin="8"
                                 Text="{Binding SelectedText}"
                                 TextWrapping="Wrap"
                                 FontFamily="{DynamicResource Fonts.Monospace}"/>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>

    <TextBlock Grid.Row="0"
               Text="{DynamicResource Text.Reviews.Empty}"
               IsVisible="{Binding Items.Count, Converter={x:Static c:IntConverters.IsZero}}"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               TextWrapping="Wrap" MaxWidth="420" Margin="16"
               Foreground="{DynamicResource Brush.FG2}"/>

    <TextBlock Grid.Row="1"
               Margin="0,6,0,0"
               Text="{Binding Status}"
               TextWrapping="Wrap"
               IsVisible="{Binding Status, Converter={x:Static c:StringConverters.IsNotNullOrWhitespace}}"/>
  </Grid>
</UserControl>
